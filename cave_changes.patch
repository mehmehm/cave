+# Settings for run_experiments.sh. Edit the two marked lines once.
+
+# >>> EDIT: the command you normally run in your FIRST terminal to open the cave world.
+# It must start Gazebo with the LTU-CEG cave loaded (gzserver), e.g.
+#   WORLD_CMD="roslaunch my_cave_pkg ltu_cave.launch gui:=false"
+#   WORLD_CMD="roslaunch gazebo_ros empty_world.launch world_name:=$HOME/worlds/ltu_ceg.world gui:=false"
+WORLD_CMD=""
+
+# >>> EDIT if your LIO-SAM uses its own launch file (A1 IMU / velodyne_points_timed params).
+LIO_SAM_LAUNCH="$(rospack find lio_sam 2>/dev/null)/launch/run.launch"
+
+# Workspaces to source (in order).
+ROS_SETUP=/opt/ros/noetic/setup.bash
+WORKSPACES=("$HOME/catkin_ws/devel/setup.bash" "$HOME/a1_ws/devel/setup.bash")
+
+# Run settings (can also be given on the command line, see --help).
+CONFIGS="LIDAR_ONLY RGB_LIDAR THERMAL_LIDAR ADAPTIVE"
+REPEATS=1
+CONDITION=MIXED
+MAX_RUN_SECONDS=2400          # 40 min of simulation time per run
+MAX_LINEAR_SPEED=0.35
+THRESHOLD_MODE=fixed          # or auto
+RESULTS_DIR="$HOME/a1_ws/experiments/results"
+LOG_DIR="$HOME/a1_ws/experiments/logs"
+WALL_TIMEOUT_SECONDS=10800    # safety stop if the sim runs very slowly (3 h)
